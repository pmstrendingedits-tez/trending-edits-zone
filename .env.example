# MongoDB Atlas free-tier connection string
# Get one free at https://www.mongodb.com/cloud/atlas/register (M0 cluster, 512MB, free forever)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trending-edits-zone?retryWrites=true&w=majority
MONGODB_URI=

# Admin login credentials
ADMIN_USERNAME=admin
# Generate a bcrypt hash for your password: run `node scripts/hash-password.js yourpassword`
ADMIN_PASSWORD_HASH=

# Random long secret string used to sign admin login JWT (any random string, keep secret)
JWT_SECRET=

# Public site info
NEXT_PUBLIC_SITE_NAME=Trending Edits Zone
NEXT_PUBLIC_SITE_URL=https://trending-edits-zone.vercel.app
